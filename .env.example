# Required for database-backed forms, leads, imports, and analytics
DATABASE_URL=

# Required for administrator authentication
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ADMIN_EMAIL=anthonyeaves33@gmail.com

# Public canonical URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required in production for public forms
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional inbound submission notifications only
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NOTIFICATION_EMAIL=info@orbisy.com

# Feature controls
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=90
RATE_LIMIT_SECRET=

# Required for the database-backed Phase 3 worker. Use at least 24 random characters.
PREFLIGHT_WORKER_SECRET=
# Optional override; otherwise the bounded value stored in Settings is used.
ORBISY_FETCHER_USER_AGENT=OrbisyPreflight/1.0 (+https://orbisy.com/preflight)
