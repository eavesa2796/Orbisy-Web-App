# Required for database-backed forms, leads, imports, and analytics
DATABASE_URL=

# Required for administrator authentication
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ADMIN_EMAIL=admin@example.com

# Public canonical URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required in production for public forms
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional inbound submission notifications only
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NOTIFICATION_EMAIL=notifications@example.com

# Feature controls
# Optional source/campaign capture on saved inquiries. No proprietary event collection.
INQUIRY_ATTRIBUTION_ENABLED=true
# Legacy ANALYTICS_ENABLED=false is still honored for attribution.
# ANALYTICS_RETENTION_DAYS is retired; existing event records are preserved.
RATE_LIMIT_SECRET=

# Required for the database-backed Phase 3 worker. Use at least 24 random characters.
PREFLIGHT_WORKER_SECRET=
# Optional override; otherwise the bounded value stored in Settings is used.
ORBISY_FETCHER_USER_AGENT=OrbisyPreflight/1.0 (+https://orbisy.com/preflight)

# Required only when invoking the separately protected Phase 4 worker.
DEEP_AUDIT_WORKER_SECRET=
# Optional performance provider. Leave empty to record PageSpeed as unavailable.
PAGESPEED_API_KEY=

# Association prospect scans are server-only and disabled until the private
# dashboard, database migration, search key, and worker path have been verified.
ASSOCIATION_PROSPECTING_ENABLED=false
BRAVE_SEARCH_API_KEY=

# Inbound email follow-up: server-only, disabled until reviewed and configured.
# Existing RESEND_API_KEY / RESEND_FROM_EMAIL are reused; Gmail stays the mailbox provider.
FOLLOWUP_SEND_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
FOLLOWUP_TOKEN_ENCRYPTION_KEY=
FOLLOWUP_CRON_SECRET=
FOLLOWUP_RESEND_WEBHOOK_SECRET=
FOLLOWUP_UNSUBSCRIBE_SECRET=
FOLLOWUP_POSTAL_ADDRESS=
